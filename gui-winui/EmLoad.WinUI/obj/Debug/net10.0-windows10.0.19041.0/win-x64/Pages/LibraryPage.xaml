<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmLoad.WinUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EmLoad.WinUI.Services"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource PageTitle}" Text="Sideloaded apps" />
            <TextBlock
                Style="{StaticResource PageSubtitle}"
                Text="Free Apple ID signatures expire after 7 days. Refresh an app to re-sign and reinstall it before it stops opening." />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            Margin="0,0,0,12">
            <Button x:ConnectionId='17'
                x:Name="RefreshAllButton"
                Style="{StaticResource AccentButtonStyle}"
                Content="Refresh all"
                                         />
            <Button x:ConnectionId='18' Content="Reload"                      />
            <ProgressRing x:ConnectionId='19' x:Name="Busy" Width="18" Height="18" IsActive="False" />
            <TextBlock x:ConnectionId='20'
                x:Name="CountText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorder}"
            Padding="8"
            VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:ConnectionId='3'
                    x:Name="HeaderGrid"
                    Grid.Row="0"
                    Padding="12,6"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeader}" Text="APP" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeader}" Text="BUNDLE ID" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeader}" Text="INSTALLED" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeader}" Text="EXPIRES" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeader}" Text="TIME LEFT" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeader}" Text="ACTIONS" />
                </Grid>

                <TextBlock x:ConnectionId='4'
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Padding="8,28"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Nothing here yet — sideload an app and it shows up with its expiry countdown." />

                <ListView x:ConnectionId='5'
                    x:Name="AppsList"
                    Grid.Row="1"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate                                 >
                            <Grid x:ConnectionId='7' ColumnSpacing="10" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <Image x:ConnectionId='15'
                                        x:Name="RowIcon"
                                        Width="28"
                                        Height="28"
                                        Stretch="Uniform"
                                                               
                                                            />
                                    <TextBlock x:ConnectionId='16'
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                                                   
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock x:ConnectionId='8'
                                    Grid.Column="1"
                                    Style="{StaticResource TableCell}"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                                             />

                                <TextBlock x:ConnectionId='9'
                                    Grid.Column="2"
                                    Style="{StaticResource TableCell}"
                                                                  />

                                <TextBlock x:ConnectionId='10'
                                    Grid.Column="3"
                                    Style="{StaticResource TableCell}"
                                                                />

                                <TextBlock x:ConnectionId='11'
                                    Grid.Column="4"
                                    Style="{StaticResource TableCell}"
                                                                 />

                                <StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Button x:ConnectionId='12'
                                        Content="Refresh"
                                                               
                                                                 />
                                    <Button x:ConnectionId='13'
                                        Content="Uninstall"
                                                               
                                                                />
                                    <Button x:ConnectionId='14'
                                        Content="Forget"
                                                               
                                                             />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock x:ConnectionId='2'
            x:Name="StatusLine"
            Grid.Row="3"
            Margin="2,10,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="" />
    </Grid>
</Page>

