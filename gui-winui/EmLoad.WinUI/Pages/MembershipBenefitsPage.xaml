<Page
    x:Class="EmLoad.WinUI.Pages.MembershipBenefitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="900" Padding="36,32" Spacing="18">
            <StackPanel Spacing="8">
                <TextBlock Text="♛  MEMBERSHIP" Foreground="#FFFFC247" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="TierTitle" Text="EmLoad Plus" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="TierDescription" Text="Your Patreon membership is active." TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
            </StackPanel>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Included benefits" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="• JIT tools" TextWrapping="Wrap" />
                    <TextBlock x:Name="StoreBenefit" Text="• EmLoadStore Companion installs" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProStoreNotice" Text="EmLoad Pro does not include EmLoadStore Companion installs."
                               Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="Manage Patreon membership"
                                     NavigateUri="https://www.patreon.com/cw/EmAppleFlagship/membership" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
