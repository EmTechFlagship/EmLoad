<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmLoad.WinUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EmLoad.WinUI.Services"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource PageTitle}" Text="Sideloaded apps" />
            <TextBlock
                Style="{StaticResource PageSubtitle}"
                Text="Free Apple ID signatures expire after 7 days. Refresh an app to re-sign and reinstall it before it stops opening." />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="10"
            Margin="0,0,0,12">
            <Button
                x:Name="RefreshAllButton"
                Style="{StaticResource AccentButtonStyle}"
                Content="Refresh all"
                Click="RefreshAll_Click" />
            <Button Content="Reload" Click="Reload_Click" />
            <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" />
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorder}"
            Padding="8"
            VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid
                    x:Name="HeaderGrid"
                    Grid.Row="0"
                    Padding="12,6"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeader}" Text="APP" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeader}" Text="BUNDLE ID" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeader}" Text="INSTALLED" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeader}" Text="EXPIRES" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeader}" Text="TIME LEFT" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeader}" Text="ACTIONS" />
                </Grid>

                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Padding="8,28"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Nothing here yet — sideload an app and it shows up with its expiry countdown." />

                <ListView
                    x:Name="AppsList"
                    Grid.Row="1"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:LibraryApp">
                            <Grid ColumnSpacing="10" MinHeight="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <Image
                                        x:Name="RowIcon"
                                        Width="28"
                                        Height="28"
                                        Stretch="Uniform"
                                        Loaded="RowIcon_Loaded"
                                        Tag="{x:Bind Icon}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource TableCell}"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    Text="{x:Bind BundleId}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TableCell}"
                                    Text="{x:Bind InstalledText}" />

                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource TableCell}"
                                    Text="{x:Bind ExpiresText}" />

                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource TableCell}"
                                    Text="{x:Bind TimeLeftText}" />

                                <StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <Button
                                        Content="Refresh"
                                        Tag="{x:Bind BundleId}"
                                        Click="RefreshOne_Click" />
                                    <Button
                                        Content="Uninstall"
                                        Tag="{x:Bind BundleId}"
                                        Click="Uninstall_Click" />
                                    <Button
                                        Content="Forget"
                                        Tag="{x:Bind BundleId}"
                                        Click="Forget_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock
            x:Name="StatusLine"
            Grid.Row="3"
            Margin="2,10,0,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="" />
    </Grid>
</Page>
