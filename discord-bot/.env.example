# Bot token from the Discord Developer Portal. Enable the Message Content intent.
DISCORD_TOKEN=

# Em Community
GUILD_ID=1564425544161038489

# Optional. Category where ticket channels are created. The bot creates "Tickets" if this is empty.
TICKET_CATEGORY_ID=

# Optional. Comma-separated role IDs that can see and reply to tickets.
# Administrators can always see them. Example: 123,456
STAFF_ROLE_IDS=

# Optional. Channel ID that receives a transcript when a ticket is closed.
LOG_CHANNEL_ID=

# Optional. User ID allowed to run !jsk refresh. Defaults to the application owner.
OWNER_ID=
